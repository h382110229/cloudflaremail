# 复制为 .env 后填真值。
# 真值保存在 Google Drive：Muse-Data/cloudflaremail/secrets（不要提交到仓库，本仓库是 public）。
# 每个值的获取方式见 docs/DESIGN.md 第 7 节。

# Resend 发信（https://resend.com/api-keys 后台创建）
RESEND_API_KEY=

# 收信 webhook 签名，Worker 和 Next.js 应用共用
# 生成：openssl rand -hex 32
INBOUND_WEBHOOK_SECRET=

# 应用公网地址（中转 Worker 的转发目标：$APP_URL/api/inbound）
APP_URL=https://mail.example.com

# 数据目录（SQLite 文件 + 附件 + 原始邮件存档）
DATA_DIR=./data

# 发信默认 From 地址（需是 Resend 已验证域名下的地址）
MAIL_FROM=noreply@mail.example.com

# 登录会话密钥（Phase 4 用，生成：openssl rand -hex 32）
SESSION_SECRET=
